# CareerForge AI — Backend Environment Variables
# Copy this file to .env and fill in the values. NEVER commit .env to source control.

# --- Application ---
APP_NAME="CareerForge AI"
APP_ENV=development          # development | production
DEBUG=true
SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# PostgreSQL (Default Target Database):
DATABASE_URL=postgresql+asyncpg://careerforge:password@localhost:5433/careerforge_db
DATABASE_URL_SYNC=postgresql://careerforge:password@localhost:5433/careerforge_db
# Optional SQLite fallback:
# DATABASE_URL=sqlite+aiosqlite:///./careerforge.db
# DATABASE_URL_SYNC=sqlite:///./careerforge.db

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Judge0 (Code Execution) ---
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_judge0_api_key_here
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# --- AI / LLM (Ollama with Gemma 12B) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b-mlx
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2

# --- Logging ---
LOG_LEVEL=INFO

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
